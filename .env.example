# 复制本文件为 `.env` 后再填写真实值。
# 当前库默认不会自动读取 `.env`。
# 如果你希望 `import agentorch` 时自动加载 `.env`，先设置：
# AGENTORCH_AUTO_LOAD_ENV=1

# ----------------------------
# 1) 最小聊天能力
# ----------------------------
# 三者里至少需要：
# - OPENAI_API_KEY
# - OPENAI_BASE_URL
# - OPENAI_CHAT_MODEL 或 OPENAI_MODEL 或 AGENTORCH_MODEL

OPENAI_API_KEY=sk-8G2N7WUGzWccp7miVayZSVl1y6cWud3W7dAcVK2OhCg3y1E2
OPENAI_BASE_URL=https://www.dmxapi.cn/v1

# 推荐优先填写 OPENAI_CHAT_MODEL。
OPENAI_CHAT_MODEL=deepseek-v4-flash
# 兼容写法：如果你已有旧脚本，也可填写其中之一。
OPENAI_MODEL=deepseek-v4-flash
AGENTORCH_MODEL=deepseek-v4-flash

# 可选视觉模型
OPENAI_VISION_MODEL=

# ----------------------------
# 2) Embedding
# ----------------------------
# 不填则默认回退到 OPENAI_API_KEY / OPENAI_BASE_URL
OPENAI_EMBEDDING_API_KEY=sk-n6pRbjUHLezmlXl28034112c974248Ef8473776fD5F1AfB2
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=

# ----------------------------
# 3) Text-to-Speech
# ----------------------------
OPENAI_TTS_API_KEY=
OPENAI_TTS_BASE_URL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_SPEED=1.0

# ----------------------------
# 4) Image Generation
# ----------------------------
# 注意：
# - OPENAI_IMAGE_BASE_URL 要填“服务根地址”，不要直接写 /chat/completions
# - 如果服务商要求单独的图片 endpoint，再使用 OPENAI_IMAGE_EXPLICIT_URL
OPENAI_IMAGE_API_KEY=sk-Yja268sdHSQ5d3QP8c2f71Cc61F4465d99738e6412D6C5C8
OPENAI_IMAGE_BASE_URL=https://api.apiyi.com/v1
OPENAI_IMAGE_EXPLICIT_URL=
OPENAI_IMAGE_MODEL=gemini-2.5-pro
OPENAI_IMAGE_ASPECT_RATIO=16:9
OPENAI_IMAGE_SIZE=2K
OPENAI_IMAGE_TIMEOUT=300
OPENAI_IMAGE_FALLBACK_MODELS=
OPENAI_IMAGE_RETRY_WITHOUT_PROXY=1
OPENAI_IMAGE_DISABLE_ENV_PROXY=0

# ----------------------------
# 5) Video
# ----------------------------
OPENAI_VIDEO_API_KEY=
OPENAI_VIDEO_BASE_URL=
OPENAI_VIDEO_MODEL=
OPENAI_VIDEO_DISABLE_ENV_PROXY=1

# ----------------------------
# 6) Web Search
