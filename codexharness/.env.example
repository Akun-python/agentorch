# Primary text model for codexharness planner / reviewer / integrator agents
CODEXHARNESS_MODEL_NAME=gpt-4.1-mini

# OpenAI-compatible endpoint and credentials used by codexharness itself
CODEXHARNESS_BASE_URL=https://api.openai.com/v1
CODEXHARNESS_API_KEY=sk-your-harness-api-key

# Separate model/API/base URL for child Codex CLI tasks
CODEXHARNESS_CODEX_MODEL_NAME=gpt-5.3-codex
CODEXHARNESS_CODEX_BASE_URL=https://api.openai.com/v1
CODEXHARNESS_CODEX_API_KEY=sk-your-codex-api-key

# Optional: override the Codex CLI path on Windows
# CODEXHARNESS_CODEX_BIN=C:\Users\<user>\AppData\Roaming\npm\codex.cmd
